{
  "name": "warket-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "wrangler types && tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply warket --local",
    "db:migrate:remote": "wrangler d1 migrations apply warket --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  }
}
